# FalkorDB connection. Local docker: redis://127.0.0.1:6379
# Railway: redis://${{FalkorDB.RAILWAY_PRIVATE_DOMAIN}}:6379
# FalkorDB Cloud: rediss://default:<password>@<host>:<port>
FALKORDB_URL=redis://127.0.0.1:6379

# Any OpenAI-compatible model with tool calling. Optional: without it, "Run postmortem" still works.
# Gemini free tier:  GEMINI_API_KEY=...            (LLM_MODEL defaults to gemini-2.5-flash)
# OpenAI:            OPENAI_API_KEY=...            (LLM_MODEL defaults to gpt-4.1-mini)
# Anything else:     LLM_API_KEY=... LLM_BASE_URL=https://.../v1 LLM_MODEL=...
GEMINI_API_KEY=
LLM_MODEL=

# Optional tuning
# Pages of 50 per list when loading a wallet
INGEST_PAGES=6
# Outflows the wallet did not sign whose signer is looked up
DETAIL_LOOKUPS=25
# Per-IP limit on the public demo
RUNS_PER_HOUR=40
# Blockscout PRO key, if you hit rate limits
# BLOCKSCOUT_API_KEY=
# Per-chain overrides: RPC_ETHEREUM=https://...  BLOCKSCOUT_ETHEREUM=https://.../api/v2  (also BASE, ARBITRUM, OPTIMISM, POLYGON, GNOSIS)
